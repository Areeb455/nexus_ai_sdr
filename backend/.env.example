# NEXUS AI SDR - Environment Configuration

# Database
# Default: SQLite for seamless local evaluation without requiring external Postgres service.
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/nexus_sdr
DATABASE_URL=sqlite:///./nexus_sdr.db

# Security & JWT
JWT_SECRET=super-secret-nexus-key-change-in-production-2026-secure-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional - If neither is provided, system runs dynamic heuristic intelligence engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default LLM Provider: "gemini", "openai", or "heuristic"
DEFAULT_AI_PROVIDER=heuristic

# Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
